---
import Layout from '../layouts/Layout.astro';
---

<Layout title="AKhoai - Solutions & Software">
  <main class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-8">Welcome to AKhoai</h1>
    <p class="text-xl mb-12">Building innovative solutions and software.</p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="p-6 border rounded-lg">
        <h2 class="text-2xl font-semibold">Phonetik</h2>
        <p>Learning app (iOS)</p>
      </div>
      <div class="p-6 border rounded-lg">
        <h2 class="text-2xl font-semibold">inWeek</h2>
        <p>Productivity app (soon)</p>
      </div>
      <div class="p-6 border rounded-lg">
        <h2 class="text-2xl font-semibold">ezTerm</h2>
        <p>Tools (soon)</p>
      </div>
      <div class="p-6 border rounded-lg">
        <h2 class="text-2xl font-semibold">crossO</h2>
        <p>Games (iOS & Android)</p>
      </div>
    </div>
  </main>
</Layout>
