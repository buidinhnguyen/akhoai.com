---
import Layout from '../layouts/Layout.astro';

const categories = [
  {
    name: 'Learning',
    apps: [{ 
        name: 'Phonetik', 
        tag: 'iOS', 
        desc: 'Learning application for phonetics.', 
        color: 'blue', 
        link: 'https://apps.apple.com/ng/app/phonetik/id1254802893' 
    }]
  },
  {
    name: 'Productivity',
    apps: [{ 
        name: 'inWeek', 
        tag: 'Coming Soon', 
        desc: 'Productivity optimized.', 
        color: 'green',
        link: '#' 
    }]
  },
  {
    name: 'Tools',
    apps: [{ 
        name: 'ezTerm', 
        tag: 'Coming Soon', 
        desc: 'Essential business tools.', 
        color: 'green',
        link: '#' 
    }]
  },
  {
    name: 'Media & Entertainment',
    apps: [{ 
        name: 'crossO', 
        tag: 'iOS & Android', 
        desc: 'Engaging games for everyone.', 
        color: 'purple',
        links: [
            { name: 'App Store', url: 'https://apps.apple.com/ng/app/crosso-caro-game/id6829106208' },
            { name: 'Google Play', url: 'https://play.google.com/store/apps/details?id=com.akhoai.crosso' }
        ]
    }]
  }
];
---

<Layout title="AKHOAI - Business Solutions & Software">
  <!-- Navigation -->
  <header class="w-full bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
      <a href="/" class="text-3xl font-bold text-gray-900 tracking-tight">AKHOAI</a>
      <nav class="hidden md:flex space-x-8 font-bold text-sm uppercase text-gray-700">
        <a href="#" class="hover:text-amber-500">Home</a>
        <a href="#" class="hover:text-amber-500">Products</a>
        <a href="#" class="hover:text-amber-500">Contact</a>
      </nav>
      <div class="hidden"></div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="bg-blue-400 py-24 text-white text-center">
    <div class="max-w-3xl mx-auto px-6">
      <h1 class="text-6xl font-bold mb-4">AKHOAI Solutions</h1>
      <p class="text-xl opacity-90">We provide many solutions for Beautiful Life.</p>
    </div>
  </section>

  <!-- Products Section -->
  <main class="max-w-7xl mx-auto px-6 py-20">
    {categories.map(cat => (
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-gray-800 mb-8 border-l-4 border-amber-500 pl-4">{cat.name}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {cat.apps.map(product => (
            <div class="bg-white border border-gray-100 rounded-lg shadow-sm hover:shadow-md transition p-6 flex flex-col h-full">
              <h3 class="text-xl font-bold mb-2">{product.name}</h3>
              <span class={`inline-block bg-${product.color}-100 text-${product.color}-800 text-xs font-bold px-2 py-1 rounded mb-4 uppercase tracking-wider`}>{product.tag}</span>
              <p class="text-gray-600 mb-6 flex-grow">{product.desc}</p>
              
              <div class="flex flex-col gap-2">
                {product.link && (
                    <a href={product.link} target="_blank" class="block text-center border-2 border-gray-900 rounded-full py-2 font-bold hover:bg-gray-900 hover:text-white transition">Explore</a>
                )}
                {product.links && product.links.map(l => (
                    <a href={l.url} target="_blank" class="block text-center border-2 border-gray-900 rounded-full py-2 font-bold hover:bg-gray-900 hover:text-white transition">{l.name}</a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </main>

  <!-- Footer -->
  <footer class="bg-gray-900 text-gray-400 py-12 text-center text-sm">
    <div class="max-w-7xl mx-auto px-6">
      <p>&copy; {new Date().getFullYear()} AKHOAI Solutions. All rights reserved.</p>
    </div>
  </footer>
</Layout>
