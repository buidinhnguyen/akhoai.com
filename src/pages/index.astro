---
import Layout from '../layouts/Layout.astro';

const categories = [
  {
    name: 'Learning',
    apps: [{ 
        name: 'Phonetik', 
        tag: 'iOS', 
        desc: 'Master phonetics with interactive lessons designed for optimal learning efficiency.', 
        color: 'blue', 
        link: 'https://apps.apple.com/ng/app/phonetik/id1254802893' 
    }]
  },
  {
    name: 'Productivity',
    apps: [{ 
        name: 'inWeek', 
        tag: 'Coming Soon', 
        desc: 'Organize your schedule and tasks seamlessly with inWeek.', 
        color: 'green',
        link: '#' 
    }]
  },
  {
    name: 'Tools',
    apps: [{ 
        name: 'ezTerm', 
        tag: 'Coming Soon', 
        desc: 'Essential business utilities at your fingertips.', 
        color: 'teal',
        link: '#' 
    }]
  },
  {
    name: 'Media & Entertainment',
    apps: [{ 
        name: 'crossO', 
        tag: 'iOS & Android', 
        desc: 'Classic Caro game with modern twists.', 
        color: 'purple',
        links: [
            { name: 'App Store', url: 'https://apps.apple.com/ng/app/crosso-caro-game/id6829106208' },
            { name: 'Google Play', url: 'https://play.google.com/store/apps/details?id=com.akhoai.crosso' }
        ]
    }]
  }
];
---

<Layout title="AKHOAI - Innovative App Solutions">
  <!-- Hero Section -->
  <header class="bg-gray-50 py-24">
    <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <h1 class="text-5xl font-extrabold text-gray-900 mb-6 leading-tight">Solutions for a <span class="text-amber-500">Beautiful Life</span></h1>
        <p class="text-lg text-gray-600 mb-8">We create high-quality, intuitive applications that empower your daily life and work.</p>
        <div class="flex space-x-4">
          <a href="#products" class="bg-amber-500 text-white px-8 py-3 rounded-full font-bold hover:bg-amber-600 transition">Explore Apps</a>
        </div>
      </div>
      <div class="bg-gray-200 aspect-square rounded-2xl flex items-center justify-center text-gray-400">
        <!-- Placeholder for Hero Image -->
        <span>App Showcase Illustration</span>
      </div>
    </div>
  </header>

  <!-- Products Section -->
  <main id="products" class="max-w-6xl mx-auto px-6 py-20">
    {categories.map(cat => (
      <div class="mb-20">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-10">{cat.name}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {cat.apps.map(product => (
            <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-8 hover:shadow-xl transition">
              <span class={`inline-block bg-${product.color}-100 text-${product.color}-800 text-xs font-bold px-3 py-1 rounded-full mb-4 uppercase tracking-wider`}>{product.tag}</span>
              <h3 class="text-2xl font-bold mb-3">{product.name}</h3>
              <p class="text-gray-600 mb-8">{product.desc}</p>
              
              <div class="flex flex-col gap-3">
                {product.link && (
                    <a href={product.link} target="_blank" class="block text-center bg-gray-900 text-white rounded-lg py-3 font-bold hover:bg-gray-700 transition">Download Now</a>
                )}
                {product.links && product.links.map(l => (
                    <a href={l.url} target="_blank" class="block text-center border border-gray-300 rounded-lg py-3 font-bold hover:bg-gray-50 transition">{l.name}</a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </main>

  <!-- Footer -->
  <footer class="bg-white border-t border-gray-100 py-12 text-center text-gray-500">
    <p>&copy; {new Date().getFullYear()} AKHOAI Solutions. All rights reserved.</p>
  </footer>
</Layout>
